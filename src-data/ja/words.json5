// Multi-kanji compound overrides for ja-g2p. Used before the per-kanji
// substitution so irregular readings (gikun, fixed compound words) win
// over the default on'yomi mapping.
//
// Sources: native-speaker intuition + JMdict common-word readings.
// Keep this list focused on words whose surface form is genuinely
// irregular — anything that ja-g2p can derive from per-kanji on'yomi
// (e.g. 新幹線 = しん+かん+せん) does NOT belong here.
{
  // Date words with native-Japanese (gikun) readings
  "今日": "きょう",
  "明日": "あした",
  "昨日": "きのう",
  "明後日": "あさって",
  "一昨日": "おととい",
  "一昨昨日": "さきおととい",
  "今朝": "けさ",
  "今晩": "こんばん",
  "今夜": "こんや",
  "今年": "ことし",
  "去年": "きょねん",

  // People — kun readings dominate, on readings are wrong here
  "私": "わたし",
  "僕": "ぼく",
  "俺": "おれ",
  "君": "きみ",
  "彼": "かれ",
  "彼女": "かのじょ",
  "誰": "だれ",
  "皆": "みんな",
  "大人": "おとな",
  "子供": "こども",
  "一人": "ひとり",
  "二人": "ふたり",
  "友達": "ともだち",
  "兄弟": "きょうだい",
  "姉妹": "しまい",
  "両親": "りょうしん",

  // Numbers/counters with irregular readings
  "二十": "にじゅう",
  "一日": "ついたち",
  "二日": "ふつか",
  "三日": "みっか",
  "四日": "よっか",
  "五日": "いつか",
  "六日": "むいか",
  "七日": "なのか",
  "八日": "ようか",
  "九日": "ここのか",
  "十日": "とおか",
  "二十日": "はつか",
  "一回": "いっかい",
  "一杯": "いっぱい",

  // Common irregular nouns/places
  "東京": "とうきょう",
  "大阪": "おおさか",
  "京都": "きょうと",
  "日本": "にほん",
  "下手": "へた",
  "上手": "じょうず",
  "綺麗": "きれい",
  "綺麗": "きれい",
  "素敵": "すてき",
  "本当": "ほんとう",
  "果物": "くだもの",
  "眼鏡": "めがね",
  "今": "いま",
  "間": "あいだ",
  "席": "せき",
  "隣": "となり",
  "本": "ほん",
  "鞄": "かばん",
  "私服": "しふく",
  "手帳": "てちょう",

  // Compound verbs with mixed/kun stems
  "読む": "よむ",
  "書く": "かく",
  "聞く": "きく",
  "話す": "はなす",
  "見る": "みる",
  "来る": "くる",
  "行く": "いく",
  "出る": "でる",
  "入る": "はいる",
  "取る": "とる",
  "持つ": "もつ",
  "待つ": "まつ",
  "立つ": "たつ",
  "座る": "すわる",
  "歩く": "あるく",
  "走る": "はしる",
  "始める": "はじめる",
  "終わる": "おわる",
  "書き込み": "かきこみ",
  "取り出し": "とりだし",
  "読んで": "よんで",

  // Misc compound words
  "新幹線": "しんかんせん",
  "来週": "らいしゅう",
  "予定": "よてい",
  "集中力": "しゅうちゅうりょく",
  "感心": "かんしん",
  "女性": "じょせい",
  "男性": "だんせい",
  "分厚い": "ぶあつい",
  "静か": "しずか",
}
